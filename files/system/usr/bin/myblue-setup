#!/usr/bin/bash
# One-time secureblue setup for a new machine.
# Every step asks first, so it is safe to re-run.
set -euo pipefail

ask() {
  local answer
  read -rp "$1 [y/N] " answer
  [[ $answer == [yY]* ]]
}

step() {
  if ask "Run 'ujust $*'?"; then
    ujust "$@" || printf "'ujust %s' failed, continuing\n" "$*" >&2
  fi
  printf '\n'
}

# secureblue has a pull request removing `ujust install-steam`. This does
# what its Flatpak method did, from the unfiltered Flathub remote, which the
# dotfiles add as "flathub".
install_steam() {
  ask 'Install Steam from Flathub?' || return 0
  flatpak install -y --user --or-update flathub com.valvesoftware.Steam || return
  # Without hardened_malloc, and with the permissions it needs despite
  # flatpak-permissions-lockdown. Controllers also need --device=input if
  # that is denied globally; anti-cheat needs --allow=devel and ptrace (below).
  flatpak override --user --unset-env=LD_PRELOAD --nofilesystem=host-os \
    --share=network --share=ipc --socket=x11 --socket=pulseaudio \
    --allow=multiarch --allow=per-app-dev-shm com.valvesoftware.Steam || return
  printf '\n'
  # Steam needs Xwayland and 32-bit syscalls, which set-kargs-hardening can
  # turn off.
  if ! pgrep -x Xwayland >/dev/null && ! pgrep -x Xorg >/dev/null; then
    step set-xwayland on
  fi
  if rpm-ostree kargs | grep -qw 'ia32_emulation=0'; then
    echo 'Steam needs 32-bit support: removing the ia32_emulation=0 boot argument.'
    rpm-ostree kargs --delete-if-present=ia32_emulation=0 || return
    printf '\n'
  fi
  echo 'Anti-cheat in some games needs ptrace.'
  step set-ptrace on
  echo 'Reboot before starting Steam if any of this changed.'
}

step set-kargs-hardening
step setup-usbguard
step set-container-userns on
step set-unconfined-userns on
step flatpak-permissions-lockdown
step harden-flatpak
printf "Mullvad's DNS doesn't work with Unbound, secureblue's other resolver.\n"
step dns-selector resolver resolved
install_steam || echo 'Installing Steam failed, continuing' >&2
printf '\n'

printf 'The next two are toggles: running them again turns them back off.\n\n'
step toggle-mac-randomization

cat <<'EOF'
Trivalent: add these JavaScript JIT exceptions by hand:

  [*.]notesnook.com
  [*.]tuta.com
  [*.]peergos.net
  app.element.io
  discord.com
  chrome-extension://mendokngpagmkejfpmeellpppjgbpdaj
  chrome-extension://nngceckbapebfimnlniiiahkandclblb

Proton Mail Bridge: open it from the app menu, sign in, then in its
settings turn on "Open on startup" and turn off "Automatic updates".
The image keeps Bridge up to date; Bridge's own updates would run from
your home folder instead.

Peergos: open it and turn on "Start on boot" in its settings, if it
isn't on already.

Mullvad VPN: the image runs its daemon; there is no GUI. Log in with
`mullvad account login`, then `mullvad auto-connect set on` and
`mullvad connect`.

Bash environment lockdown resets ~/.bashrc, ~/.bash_profile, ~/.bashrc.d
and ~/.config/environment.d to secureblue's defaults (backups go to
~/bash_env_files) and makes them immutable. Your shell settings are in the
image (/etc/profile.d/myblue.sh), so nothing is lost. Change them there.

EOF
step toggle-bash-environment-lockdown
